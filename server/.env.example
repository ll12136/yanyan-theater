# 本文件是模板：复制成 server/.env 后填真实值。server/.env 已被 .gitignore 排除，不会进仓库。
#
# 服务端启动时自动加载本目录下的 .env（再兜底读项目根 .env），
# 规则是「真实环境变量优先」，所以部署平台上注入的值一定会覆盖这里的值。

# ── 知乎登录（OAuth）──────────────────────────────────────────────
# 从知乎黑客松活动页面「创建项目」后拿到。三个缺任何一个，
# /api/auth/zhihu/login 都会返回 503「知乎登录尚未配置」。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 必须与活动页面上登记的「知乎登录回调地址」**完全一致**（协议、域名、路径、末尾斜杠都不能差），
# 否则知乎会拒绝授权，或回调打不到服务端的路由上。
# 服务端实际处理回调的路由是 /api/auth/zhihu/callback。
ZHIHU_OAUTH_REDIRECT_URI=

# ── 知乎开放平台内容（可选）──────────────────────────────────────
# 用来把「知乎原文」换成官方链接。与上面的 APP_KEY 不是一回事，别串位。
# 不配也能完整玩：原文回落到站内搜索页，并如实标注来源。
ZHIHU_ACCESS_SECRET=

# ── DeepSeek（可选，强烈建议）────────────────────────────────────
# 把知乎原文改编成三幕剧情。不配则退到本地五幕示例剧情。
DEEPSEEK_API_KEY=

# ── 服务端口 ─────────────────────────────────────────────────────
# 同时用于发前端 dist/ 和代理接口，默认 3000。
# PORT=3000
